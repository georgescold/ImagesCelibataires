{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generer.py": {
      "maxDuration": 300,
      "includeFiles": "gen/**"
    },
    "api/index.py": {
      "includeFiles": "web/**"
    },
    "api/carte.py": {
      "includeFiles": "{gen,cartes}/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    }
  ]
}
