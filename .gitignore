# --- secrets ---------------------------------------------------------------
.env

# --- photos scrapees du compte source --------------------------------------
# analyse/ contient 65 photos de personnes reelles recuperees sur TikTok,
# plus les planches contact fabriquees a partir d'elles. Ces images ne
# m'appartiennent pas et representent des personnes identifiables : elles
# n'ont rien a faire dans un depot public.
analyse/

# --- carrousels generes ----------------------------------------------------
# On ignore tout ce qui se trouve dans gen/, puis on re-autorise le code.
# Les images pesent 123 Mo, le code 177 Ko.
gen/*
!gen/*.py
!gen/*.html
!gen/*.bat

# registres d'etat (prenoms, poses et lieux deja utilises)
gen/_*.json

# --- divers ----------------------------------------------------------------
__pycache__/
*.pyc
*.jpg
*.jpeg
*.png
# ...sauf les avatars et blasons exportes par Compaatible : la carte de
# personnalite en a besoin, en local comme en ligne.
!cartes/**/*.png
# ...et les icones de l'app installable (gen/faire_icones.py) : sans elles,
# l'ecran d'accueil du telephone n'aurait pas d'icone.
!web/icones/*.png
Thumbs.db
desktop.ini
